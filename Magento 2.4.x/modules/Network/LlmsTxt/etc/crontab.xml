<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="network_llmstxt_generate"
             instance="Network\LlmsTxt\Cron\Generate"
             method="execute">
            <!-- Codziennie o 03:00 w nocy -->
            <schedule>0 3 * * *</schedule>
        </job>
    </group>
</config>