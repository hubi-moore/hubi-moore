<?xml version="1.0"?>
<!--
    Handle customer_account_index odpowiada stronie /customer/account/
    (panel klienta) - to na nią Magento standardowo przekierowuje
    zaraz po pomyślnym utworzeniu konta (Krok 2 - Założenie konta).
    Blok renderuje się TYLKO gdy ustawiona jest flaga z sesji
    (patrz Observer/SetRegistrationFlag.php) - czyli tylko raz,
    bezpośrednio po rejestracji, a nie przy każdym zwykłym logowaniu.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Network\GtmRegistrationTracking\Block\RegistrationSuccess"
                   name="gtm.registration.step2"
                   template="Network_GtmRegistrationTracking::registration_step2.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>
